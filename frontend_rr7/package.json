{
  "name": "lasius-frontend",
  "license": "AGPL-3.0",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "build": "yarn run typecheck && react-router build",
    "dev": "react-router dev",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint --concurrency auto .",
    "lint:fix": "eslint --fix --cache --cache-location ./node_modules/.cache/eslint --concurrency auto .",
    "start": "react-router-serve build/server/index.js",
    "typecheck": "react-router typegen && tsc --build --noEmit",
    "check": "yarn typecheck && yarn lint:fix && yarn prettier && echo '✓ Frontend check passed!'",
    "fallow": "fallow check",
    "prettier": "prettier --cache --cache-location ./node_modules/.cache/prettier --write --list-different .",
    "i18n:extract": "i18next-cli extract",
    "i18n:extract:watch": "i18next-cli extract --watch",
    "i18n:extract:ci": "i18next-cli extract --ci --dry-run --quiet",
    "i18n:types": "i18next-cli types",
    "i18n:lint": "i18next-cli lint",
    "i18n:status": "i18next-cli status",
    "orval": "orval",
    "up": "yarn upgrade-interactive"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@conform-to/react": "^1.17.1",
    "@conform-to/zod": "^1.17.1",
    "@headlessui/react": "^2.2.9",
    "@icons-pack/react-simple-icons": "^13.13.0",
    "@mdx-js/mdx": "^3.1.1",
    "@nivo/bar": "^0.99.0",
    "@nivo/core": "^0.99.0",
    "@nivo/line": "^0.99.0",
    "@nivo/pie": "^0.99.0",
    "@nivo/stream": "^0.99.0",
    "@react-router/serve": "^7.13.2",
    "accept-language-parser": "^1.5.0",
    "boring-avatars": "^2.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie": "^1.1.1",
    "d3-shape": "^3.2.0",
    "daisyui": "^5.5.19",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "es-toolkit": "^1.45.1",
    "i18next": "25.10.10",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-fetch-backend": "^7.0.0",
    "immer": "^11.1.4",
    "isbot": "^5.1.36",
    "lucide-react": "^1.7.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^16.6.6",
    "react-router": "^7.13.2",
    "remix-i18next": "^7.4.2",
    "tailwind-merge": "^3.5.0",
    "tslog": "^4.10.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-typescript": "^7.28.5",
    "@react-router/dev": "^7.13.2",
    "@tailwindcss/vite": "^4.2.2",
    "@types/accept-language-parser": "^1.5.8",
    "@types/babel__core": "^7.20.5",
    "@types/d3-shape": "^3.1.8",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/eslint-plugin": "^1.3.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "babel-plugin-react-remove-properties": "^0.3.1",
    "eslint": "^9.39.4",
    "eslint-plugin-check-file": "^3.3.1",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-perfectionist": "^5.7.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-unicorn": "^63.0.0",
    "fallow": "^2.2.1",
    "globals": "^16.3.0",
    "i18next-cli": "^1.51.3",
    "orval": "^8.6.2",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.2",
    "vite": "^8.0.3",
    "vite-plugin-babel": "^1.6.0",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=24.0.0"
