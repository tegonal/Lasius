{
  "name": "lasius-frontend",
  "license": "AGPL-3.0",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "build": "yarn run typecheck && react-router build",
    "dev": "react-router dev",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint --concurrency auto --max-warnings 0 .",
    "lint:fix": "eslint --fix --cache --cache-location ./node_modules/.cache/eslint --concurrency auto --max-warnings 0 .",
    "start": "react-router-serve build/server/index.js",
    "typecheck": "react-router typegen && tsc --build --noEmit",
    "check": "yarn typecheck && yarn lint:fix && yarn prettier && echo '✓ Frontend check passed!'",
    "fallow": "fallow",
    "fallow:health": "yarn test:coverage && fallow health --coverage coverage/coverage-final.json --baseline .fallow-health-baseline.json",
    "fallow:health:baseline": "yarn test:coverage && fallow health --coverage coverage/coverage-final.json --save-baseline .fallow-health-baseline.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=json --coverage.include='app/**/*.ts'",
    "prettier": "prettier --cache --cache-location ./node_modules/.cache/prettier --write --list-different .",
    "i18n:extract": "i18next-cli extract",
    "i18n:extract:watch": "i18next-cli extract --watch",
    "i18n:extract:ci": "i18next-cli extract --ci --dry-run --quiet",
    "i18n:types": "i18next-cli types",
    "i18n:lint": "i18next-cli lint",
    "i18n:status": "i18next-cli status",
    "orval": "orval",
    "up": "yarn upgrade-interactive"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@conform-to/react": "^1.21.2",
    "@conform-to/zod": "^1.21.2",
    "@icons-pack/react-simple-icons": "^13.15.1",
    "@mdx-js/mdx": "^3.1.1",
    "@nivo/bar": "^0.99.0",
    "@nivo/core": "^0.99.0",
    "@nivo/line": "^0.99.0",
    "@nivo/pie": "^0.99.0",
    "@nivo/stream": "^0.99.0",
    "@react-router/node": "^8.4.0",
    "@react-router/serve": "^8.4.0",
    "boring-avatars": "^2.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie": "^2.0.1",
    "d3-shape": "^3.2.0",
    "daisyui": "^5.7.50",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "es-toolkit": "^1.52.0",
    "i18next": "26.4.4",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-fetch-backend": "^8.0.0",
    "immer": "^11.1.21",
    "isbot": "^5.2.2",
    "lucide-react": "^1.56.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.16",
    "react-router": "^8.4.0",
    "remix-i18next": "^8.0.0",
    "tailwind-merge": "^3.7.0",
    "tslog": "^5.2.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@react-router/dev": "^8.4.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/babel__core": "^7.20.5",
    "@types/d3-shape": "^3.2.0",
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "5.0.4",
    "@vitest/eslint-plugin": "^1.6.27",
    "babel-plugin-react-compiler": "^1.0.0",
    "babel-plugin-react-remove-properties": "^0.3.1",
    "eslint": "^10.12.0",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-perfectionist": "^5.12.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unicorn": "^71.1.0",
    "fallow": "^3.33.1",
    "globals": "^17.13.0",
    "i18next-cli": "^1.75.3",
    "orval": "^8.42.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rolldown": "1.2.13",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "yarn@4.18.1"
}
