{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "ignorePatterns": [
    "app/services/api/lasius/**",
    "app/services/api/lasius-hooks/**",
    "app/services/api/orval-fetcher-client.ts",
    ".react-router/**",
    "public/help/**"
  ],
  "entry": ["app/routes.ts", "orval.config.mjs"],
  "ignoreDependencies": [
    "@nivo/core",
    "babel-plugin-react-remove-properties",
    "daisyui",
    "immer",
    "typescript-eslint"
  ],
  "rules": {
    "unused-files": "warn",
    "unused-exports": "warn",
    "unused-types": "warn",
    "unused-dependencies": "error",
    "unused-dev-dependencies": "warn",
    "unused-enum-members": "warn",
    "unused-class-members": "warn",
    "unresolved-imports": "error",
    "unlisted-dependencies": "error",
    "duplicate-exports": "off",
    "circular-dependencies": "off",
    "type-only-dependencies": "warn"
  },
  "duplicates": {
    "mode": "mild",
    "minTokens": 50,
    "minLines": 5,
    "threshold": 15,
    "ignore": ["app/services/api/lasius/**", "app/services/api/lasius-hooks/**"]
  },
  "health": {
    "maxCyclomatic": 20,
    "maxCognitive": 15,
    "ignore": ["app/services/api/lasius/**", "app/services/api/lasius-hooks/**"],
    "thresholdOverrides": [
      {
        "files": ["app/components/ui/forms/input/date-picker/segmented-time-input-connected.tsx"],
        "functions": ["handleKeyDown"],
        "maxCyclomatic": 23,
        "maxCognitive": 26,
        "maxCrap": 552,
        "reason": "Accepted key handler. A split adds functions but not fewer cases, and no test covers the handler. Decision: rr8-segmented-input-key-handlers."
      },
      {
        "files": ["app/components/ui/forms/input/date-picker/shared/duration-segment-input.tsx"],
        "functions": ["handleKeyDown"],
        "maxCyclomatic": 22,
        "maxCognitive": 24,
        "maxCrap": 506,
        "reason": "Accepted key handler. A split adds functions but not fewer cases, and no test covers the handler. Decision: rr8-segmented-input-key-handlers."
      },
      {
        "files": ["app/components/ui/forms/input/date-picker/segmented-date-input-connected.tsx"],
        "functions": ["handleKeyDown"],
        "maxCyclomatic": 21,
        "maxCognitive": 28,
        "maxCrap": 463,
        "reason": "Accepted key handler. A split adds functions but not fewer cases, and no test covers the handler. Decision: rr8-segmented-input-key-handlers."
      },
      {
        "files": ["app/**/*.tsx", "app/**/use-*.ts"],
        "maxCrap": 1000000,
        "reason": "Unit tests run in Node without React (core/unit-testing), so a component or hook keeps 0 coverage and CRAP only repeats the complexity limits."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "app/hooks/use-api-proxy.ts",
        "app/services/api/orval-fetcher-client.ts",
        "orval.config.mjs",
        "public/help/**"
      ],
      "rules": {
        "unused-files": "off"
      }
    }
  ]
}
