{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "ignorePatterns": [
    "app/services/api/lasius/**",
    "app/services/api/lasius-hooks/**",
    "app/services/api/orval-fetcher-client.ts",
    ".react-router/**",
    "public/help/**"
  ],
  "entry": ["app/routes.ts", "orval.config.mjs"],
  "ignoreDependencies": [
    "@nivo/core",
    "babel-plugin-react-remove-properties",
    "daisyui",
    "immer",
    "typescript-eslint"
  ],
  "rules": {
    "unused-files": "warn",
    "unused-exports": "warn",
    "unused-types": "warn",
    "unused-dependencies": "error",
    "unused-dev-dependencies": "warn",
    "unused-enum-members": "warn",
    "unused-class-members": "warn",
    "unresolved-imports": "error",
    "unlisted-dependencies": "error",
    "duplicate-exports": "off",
    "circular-dependencies": "off",
    "type-only-dependencies": "warn"
  },
  "duplicates": {
    "mode": "mild",
    "minTokens": 50,
    "minLines": 5,
    "threshold": 15,
    "ignore": ["app/services/api/lasius/**", "app/services/api/lasius-hooks/**"]
  },
  "health": {
    "maxCyclomatic": 20,
    "maxCognitive": 15,
    "ignore": ["app/services/api/lasius/**", "app/services/api/lasius-hooks/**"],
    "thresholdOverrides": [
      {
        "files": ["app/routes/**"],
        "functions": ["loader", "action"],
        "maxCrap": 80,
        "reason": "Temporary since 2026-10-08. Route loaders and actions have no unit tests yet, and Playwright covers them. The ceiling of 80 keeps a loader that grows further visible."
      },
      {
        "files": ["app/routes/internal-oauth.register.tsx"],
        "functions": ["InternalOAuthRegister"],
        "maxCognitive": 16,
        "reason": "Legacy internal OAuth provider for dev, demo and E2E only. auth/register.unauth.spec.ts covers the form with six tests."
      },
      {
        "files": ["app/services/auth/providers/internal.server.ts"],
        "functions": ["loginWithCredentials"],
        "maxCrap": 45,
        "reason": "Legacy internal OAuth provider for dev, demo and E2E only. Every E2E sign-in runs this function."
      },
      {
        "files": ["app/services/auth/providers/index.ts"],
        "functions": ["createProvider"],
        "maxCrap": 35,
        "reason": "A flat factory switch with one case for each provider. A unit test repeats the switch and finds no defect."
      },
      {
        "files": ["app/features/integrations/lib/tag-config-defaults.ts"],
        "functions": ["getDefaultTagConfig"],
        "maxCrap": 35,
        "reason": "A literal table of defaults for each platform. The function holds no logic for a test to check."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "app/hooks/use-api-proxy.ts",
        "app/services/api/orval-fetcher-client.ts",
        "orval.config.mjs",
        "public/help/**"
      ],
      "rules": {
        "unused-files": "off"
      }
    }
  ]
}
